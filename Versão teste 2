function abrirWhatsApp(numeroTelefone,mensagem){

    const numero =
        telefoneWhatsApp(
            numeroTelefone
        );


    if(numero.length < 10){

        const deseja =
            confirm(
                "O telefone não está cadastrado corretamente.\n\nDeseja abrir o WhatsApp para escolher o contato?"
