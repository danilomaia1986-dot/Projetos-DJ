            item.tipo === "Parceiro" &&
            item.nome === nome
        );


    if(!itens.length){

        return;

    }


    const telefone =
        itens.find(
            x => x.telefone
        )?.telefone || "";


    const grupos = {};


    let total = 0;


    itens.forEach(item => {

        if(!grupos[item.servico]){

            grupos[item.servico] = {

                quantidade:0,
                valor:0

            };

        }


        grupos[item.servico].quantidade +=
            numero(item.quantidade);

        grupos[item.servico].valor +=
            numero(item.repasse);

        total +=
            numero(item.repasse);

    });


    let linhas = "";


    Object.keys(grupos)
        .sort()
        .forEach(servico => {

            const s =
                grupos[servico];


            linhas +=
`${servico}: ${s.quantidade} × ${moeda(s.valor / s.quantidade)} = ${moeda(s.valor)}
`;

        });


    const mensagem =
`Olá, ${nome}!

Segue o fechamento dos serviços:

${linhas}
Total a repassar: ${moeda(total)}

Projetos-DJ`;


    abrirWhatsApp(
        telefone,
        mensagem
    );

}


