    return select.value;

}


/* =====================================================
SALVAR
===================================================== */

function salvarLancamento(){

    const tipo =
        document.getElementById("tipo").value;

    const nome =
        document.getElementById("nome").value.trim();

    const telefone =
        document.getElementById("telefone").value.trim();

    const servico =
        obterServicoSelecionado();

    const valor =
        numero(
            document.getElementById(
                "valorServico"
            ).value
        );

    const quantidade =
        numero(
            document.getElementById(
                "quantidade"
            ).value
        );

    const repasse =
        numero(
            document.getElementById(
                "repasse"
            ).value
        );

    const data =
        document.getElementById("data").value
        || hoje();

    const observacao =
        document.getElementById(
            "observacao"
        ).value.trim();


    if(!nome){

        alert("Informe o nome.");

        return;

    }


    if(!servico){

        alert("Selecione o serviço.");

        return;

    }


    if(valor < 0){

        alert("Valor inválido.");

        return;

    }


    if(quantidade <= 0){

        alert(
            "Informe uma quantidade maior que zero."
        );

        return;

    }


    if(repasse < 0){

        alert("Repasse inválido.");

        return;

    }


    const total =
        valor * quantidade;

    const lucro =
        total - repasse;


    const dados = {

        id:
            editandoId ||
            Date.now().toString(),

        tipo:
            tipo,

        nome:
            nome,

        telefone:
            telefone,

        servico:
            servico,

        valorUnitario:
            valor,

        quantidade:
            quantidade,

        total:
            total,

        repasse:
            repasse,

        lucro:
            lucro,

        data:
            data,

        observacao:
            observacao

    };


    if(editandoId){

        const index =
            lancamentos.findIndex(
                x =>
                String(x.id) ===
                String(editandoId)
            );

        if(index >= 0){

            lancamentos[index] = dados;

        }

    }else{

        lancamentos.unshift(dados);

    }


    salvarDados();

    editandoId = null;

    alert(
        "Lançamento salvo com sucesso!"
    );

    limparFormulario();

    atualizarInicio();

    atualizarRelatorios();

    renderizarHistorico();

    abrirAbaPorId("movimentacoes");

}


