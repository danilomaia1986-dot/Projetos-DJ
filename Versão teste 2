/* =====================================================
FECHAMENTO DOS PARCEIROS
===================================================== */

function gerarFechamentoParceiros(){

    const container =
        document.getElementById(
            "fechamentoParceiros"
        );

    const parceiros = {};


    lancamentos
        .filter(
            item => item.tipo === "Parceiro"
        )
        .forEach(item => {

            const nome =
                item.nome || "Sem nome";


            if(!parceiros[nome]){

                parceiros[nome] = {

                    telefone:
                        item.telefone || "",

                    servicos: {},

                    totalRepasse: 0,

                    quantidade: 0

                };

            }


            const servico =
                item.servico;


            if(
                !parceiros[nome].servicos[
                    servico
                ]
            ){

                parceiros[nome].servicos[
                    servico
                ] = {

                    quantidade:0,
                    valor:0

                };

            }


            parceiros[nome].servicos[
                servico
            ].quantidade +=
                numero(item.quantidade);


            parceiros[nome].servicos[
                servico
            ].valor +=
                numero(item.repasse);


            parceiros[nome].totalRepasse +=
                numero(item.repasse);


            parceiros[nome].quantidade +=
                numero(item.quantidade);

        });


    container.innerHTML = "";


    const nomes =
        Object.keys(parceiros);


    if(nomes.length === 0){

        container.innerHTML = `
            <div class="empty">
                Nenhum serviço de parceiro cadastrado.
            </div>
        `;

        return;

    }


    nomes.sort().forEach(nome => {

        const parceiro =
            parceiros[nome];


        const card =
            document.createElement("div");

        card.className =
            "partner-card";


        let servicosHTML = "";


        Object.keys(parceiro.servicos)
            .sort()
            .forEach(servico => {

                const s =
                    parceiro.servicos[servico];


                servicosHTML += `

                    <div class="close-box">

                        <div>
                            <span>
                                ${escapar(servico)}
                            </span>

                            <strong>
                                ${s.quantidade}
                            </strong>
                        </div>

                        <div>
                            <span>
                                Valor a repassar
                            </span>

                            <strong>
                                ${moeda(s.valor)}
                            </strong>
                        </div>

                    </div>

                `;

            });


        const telefone =
            telefoneWhatsApp(
                parceiro.telefone
            );


        card.innerHTML = `

            <h3>
                ${escapar(nome)}
            </h3>

            ${servicosHTML}

            <div class="partner-total">
                Total a repassar:
                ${moeda(parceiro.totalRepasse)}
            </div>

            <div class="actions">

                <button
                    class="btn btn-secondary"
                    onclick="abrirFechamentoParceiro('${escapar(nome)}')"
                >
                    Ver fechamento
                </button>

                ${
                    telefone
                    ?
                    `
                    <button
                        class="btn btn-whatsapp"
                        onclick="whatsappParceiro('${escapar(nome)}')"
                    >
                        WhatsApp
                    </button>
                    `
                    :
                    ""
                }

            </div>

        `;


        container.appendChild(card);

    });

}


