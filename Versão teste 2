/* =====================================================
HISTÓRICO
===================================================== */

function renderizarHistorico(){

    const tbody =
        document.getElementById(
            "historico"
        );

    const nome =
        document.getElementById(
            "filtroNome"
        ).value.toLowerCase().trim();

    const tipo =
        document.getElementById(
            "filtroTipo"
        ).value;

    const servico =
        document.getElementById(
            "filtroServico"
        ).value.toLowerCase().trim();

    const inicio =
        document.getElementById(
            "filtroInicio"
        ).value;

    const fim =
        document.getElementById(
            "filtroFim"
        ).value;


    const dados =
        lancamentos.filter(item => {

            if(
                nome &&
                !String(item.nome)
                    .toLowerCase()
                    .includes(nome)
            ){

                return false;

            }

            if(
                tipo &&
                item.tipo !== tipo
            ){

                return false;

            }

            if(
                servico &&
                !String(item.servico)
                    .toLowerCase()
                    .includes(servico)
            ){

                return false;

            }

            if(
                inicio &&
                item.data < inicio
            ){

                return false;

            }

            if(
                fim &&
                item.data > fim
            ){

                return false;

            }

            return true;

        });


    let total = 0;
    let repasse = 0;
    let lucro = 0;


    dados.forEach(item => {

        total += numero(item.total);
        repasse += numero(item.repasse);
        lucro += numero(item.lucro);

    });


    document.getElementById(
        "filtroTotal"
    ).textContent = moeda(total);

    document.getElementById(
        "filtroRepasse"
    ).textContent = moeda(repasse);

    document.getElementById(
        "filtroLucro"
    ).textContent = moeda(lucro);


    tbody.innerHTML = "";


    if(dados.length === 0){

        tbody.innerHTML = `
            <tr>
                <td colspan="9" class="empty">
                    Nenhum lançamento encontrado.
                </td>
            </tr>
        `;

        return;

    }


    dados.forEach(item => {

        const tr =
            document.createElement("tr");

        const classeTipo =
            item.tipo === "Cliente"
            ?
            "badge-client"
            :
            "badge-partner";


        tr.innerHTML = `

            <td>
                ${formatarData(item.data)}
            </td>

            <td>
                <span class="badge ${classeTipo}">
                    ${escapar(item.tipo)}
                </span>
            </td>

            <td>
                <strong>
                    ${escapar(item.nome)}
                </strong>
            </td>

            <td>
                ${escapar(item.servico)}
            </td>

            <td>
                ${item.quantidade}
            </td>

            <td>
                <strong>
                    ${moeda(item.total)}
                </strong>
            </td>

            <td>
                ${moeda(item.repasse)}
            </td>

            <td>
                <strong class="${
                    item.lucro >= 0
                    ?
                    "green"
                    :
                    "red"
                }">
                    ${moeda(item.lucro)}
                </strong>
            </td>

            <td>

                <div class="actions">

                    <button
                        class="btn btn-primary"
                        onclick="abrirComprovante('${item.id}')"
                    >
                        Comprovante
                    </button>

                    <button
                        class="btn btn-secondary"
                        onclick="editarLancamento('${item.id}')"
                    >
                        Editar
                    </button>

                    <button
                        class="btn btn-danger"
                        onclick="excluirLancamento('${item.id}')"
                    >
                        Excluir
                    </button>

                </div>

            </td>

        `;

        tbody.appendChild(tr);

    });

}


